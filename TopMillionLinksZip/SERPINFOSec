pages:
  - name: Default
    matches:
      - http://www.secretsearchenginelabs.com/find/*
      - http://www.secretsearchenginelabs.com/findmore/*
    results:
      - name: Web results
        root: h3.result
        url: a[href]
        props:
          title: a[href]
      - name: Web result snippets
        root: h3.result + p
        url: [property, "textContent", ".url_link a"]
        props:
          title: [property, "textContent", ".url_link a"]
    commonProps:
      $site: secretsearchenginelabs
      $category: web

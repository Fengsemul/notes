name: SecretSearchEngineLabs
homepage: http://www.secretsearchenginelabs.com
lastModified: 2026-07-13T00:00:00Z
pages:
  - name: Default
    matches:
      - http://www.secretsearchenginelabs.com/find/*
      - http://www.secretsearchenginelabs.com/findmore/*
    results:
      - name: Web results (title)
        root: h3.result
        url: a[rel="nofollow"]
        props:
          title: a[rel="nofollow"]
      - name: Web results (snippet)
        root: [upward, 1, ".url_link"]
        url: [property, "textContent", ".url_link a"]
        props:
          title: [property, "textContent", ".url_link a"]
    commonProps:
      $site: secretsearchenginelabs
      $category: web

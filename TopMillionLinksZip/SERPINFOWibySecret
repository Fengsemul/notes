name: SecretSearchEngineLabs + Wiby
homepage: https://github.com/ublacklist/builtin#readme
lastModified: 2026-07-02T00:00:00Z

pages:
  - name: SecretSearchEngineLabs
    matches:
      - http://www.secretsearchenginelabs.com/find/
      - http://www.secretsearchenginelabs.com/find/*
    delay: true
    commonProps:
      $site: secretsearchenginelabs
      $category: web
    results:
      - name: Default
        root: .result, .results, li, article, body
        url: a
        props:
          title: a
          $category: [const, "web"]

  - name: Wiby
    matches:
      - https://wiby.org/?q=
      - https://wiby.org/?q=*
    delay: true
    commonProps:
      $site: wiby
      $category: web
    results:
      - name: Default
        root: .result, .results, li, article, body
        url: a
        props:
          title: a
          $category: [const, "web"]

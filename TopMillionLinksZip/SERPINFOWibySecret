name: SecretSearchEngineLabs + Wiby
homepage: https://github.com/ublacklist/builtin#readme
lastModified: 2026-01-01T00:00:00Z

pages:
- name: SecretSearchEngineLabs (find/query)
  matches:
  - http://www.secretsearchenginelabs.com/find/query
  - http://www.secretsearchenginelabs.com/find/query?*
  delay: true
  commonProps:
    $site: secretsearchenginelabs
  results:
  - name: Default
    root: .result, .results, li, article, body
    url: a
    props:
      title: a
      $category: web
    button:
      text
      position: afterend

- name: Wiby
  matches:
  - https://wiby.org/?q=
  - https://wiby.org/?q=*
  delay: true
  commonProps:
    $site: wiby
  results:
  - name: Default
    root: .result, .results, li, article, body
    url: a
    props:
      title: a
      $category: web
    button:
      text
      position: afterend
